# VirtuallyView environment configuration.
# Copy this file to .env and edit values. Never commit .env to git.

# --- Dashboard ---
# Web UI port. Change if 3000 is taken.
DASHBOARD_PORT=3000

# Optional: fixes the admin password instead of first-run signup.
# Leave empty to create the account in the browser on first launch.
DASHBOARD_AUTH_PASSWORD=
DASHBOARD_AUTH_USERNAME=root

# --- VPN for downloads (OPTIONAL) ---
# Used only when you activate docker-compose.vpn.yml.
# 1. Create a ProtonVPN account (free tier works) at https://account.protonvpn.com
# 2. In the dashboard: OpenVPN / WireGuard -> generate a WireGuard config
# 3. Copy the "PrivateKey" line value here. Keep this file private.
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
VPN_WIREGUARD_PRIVATE_KEY=
VPN_SERVER_COUNTRIES=Netherlands

# --- Pre-seeded service API keys ---
# These keys are for the bundled *arr services on this machine only.
# They are regenerated automatically if you change them here before first run.
RADARR_API_KEY=please-change-me
SONARR_API_KEY=please-change-me
PROWLARR_API_KEY=please-change-me
LIDARR_API_KEY=please-change-me
BAZARR_API_KEY=
