# VirtuallyView environment configuration.
# Copy this file to .env and edit values. Never commit .env to git.

# --- Dashboard ---
# Web UI port. Change if 3000 is taken.
DASHBOARD_PORT=3000

# Optional: fixes the admin password instead of first-run signup.
# Leave empty to create the account in the browser on first launch.
DASHBOARD_AUTH_PASSWORD=
DASHBOARD_AUTH_USERNAME=root

# --- VPN for downloads (OPTIONAL) ---
# No account needed: docker-compose.vpn-free.yml (VPN Gate). Optional: VPN_SERVER_COUNTRY_CODE=NL
# Used only when you activate docker-compose.vpn.yml. See docs/privacy.md.
# VPN_SERVICE_PROVIDER can be: protonvpn, mullvad, airvpn, ivpn, nordvpn,
# surfshark, windscribe, fastestvpn, or custom for any other WireGuard
# provider. The default below is ProtonVPN because it has a free tier, useful
# for trying this overlay before paying for anything; it is not an
# endorsement over the others.
# 1. Create an account with your chosen provider (protonvpn: free tier works
#    at https://account.protonvpn.com).
# 2. In their dashboard, generate a WireGuard config.
# 3. Copy the "PrivateKey" line value here. Keep this file private.
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
VPN_WIREGUARD_PRIVATE_KEY=
VPN_SERVER_COUNTRIES=Netherlands

# --- Tor for search (OPTIONAL, no account needed) ---
# Used only when you activate the "tor" profile:
#   docker compose --profile tor up -d
# See docs/privacy.md for how to point Prowlarr's Indexer Proxies, or the
# app's own Outbound proxy setting, at it. Nothing to fill in here; it is
# just a bundled Tor SOCKS5 proxy with no configuration.

# --- Offline libraries (Kiwix, OPTIONAL) ---
# Used by: docker compose --profile kiwix up -d. Space-separated folder/name-prefix
# entries to download and keep. Packs and sizes: docs/kiwix.md. Leave unset for
# the small starter set (about 18 GB).
# KIWIX_ZIMS=wikipedia/wikipedia_en_all_maxi other/mdwiki_en_all_maxi other/zimgit-post-disaster_en ifixit/ifixit_en_all

# --- Automatic updates (OPTIONAL) ---
# Used only when you activate the "auto-update" profile:
#   docker compose --profile auto-update up -d
# See docs/updates.md. On real Docker you can leave both of these as-is.
# On rootless Podman, first run: systemctl --user enable --now podman.socket
# then set DOCKER_SOCK to the path it prints (usually
# /run/user/<uid>/podman/podman.sock).
DOCKER_SOCK=/var/run/docker.sock
# How often to check for new images, in seconds. Default: once a day.
WATCHTOWER_INTERVAL_SECONDS=86400

# --- Pre-seeded service API keys ---
# These keys are for the bundled *arr services on this machine only.
# They are regenerated automatically if you change them here before first run.
RADARR_API_KEY=please-change-me
SONARR_API_KEY=please-change-me
PROWLARR_API_KEY=please-change-me
LIDARR_API_KEY=please-change-me
BAZARR_API_KEY=
