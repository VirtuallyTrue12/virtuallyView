{
  "colors": {
    "background": "#141414",
    "surface": "#1f1f1f",
    "surfaceElevated": "#2b2b2b",
    "surfaceOverlay": "rgba(20,20,20,0.94)",
    "textPrimary": "#ffffff",
    "textSecondary": "#d2d2d2",
    "textMuted": "#808080",
    "accent": "#e50914",
    "accentSoft": "rgba(229,9,20,0.18)",
    "border": "rgba(255,255,255,0.10)",
    "borderFocus": "#ffffff",
    "success": "#46d369",
    "warning": "#f5c518",
    "danger": "#e50914"
  },
